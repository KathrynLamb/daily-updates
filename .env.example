# PostgreSQL connection used by the running API.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/daily_updates

# Required only for live Claude content reviews.
# Automated tests inject a deterministic reviewer and do not use this key.
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key

HOST=127.0.0.1
PORT=3001



# OpenID Connect identity provider trusted by the API.
#
# Replace these example values with the settings supplied by the
# chosen provider. The issuer and audience must exactly match the
# claims in its access tokens.
AUTH_ISSUER=https://identity.example.com/
AUTH_AUDIENCE=daily-updates-api
AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# Comma-separated allowlist of accepted signing algorithms.
AUTH_ALGORITHMS=RS256