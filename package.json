{
  "name": "daily-updates",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "test:integration": "bash scripts/test-integration.sh",
    "test:all": "npm test && npm run test:integration",
    "local:db": "bash scripts/local-db.sh",
    "local:server": "DATABASE_URL=postgresql://daily_updates_local:daily_updates_local@127.0.0.1:55433/daily_updates_local tsx src/local-server.ts",
    "local:walkthrough": "tsx src/local-walkthrough.ts",
    "auth:login": "tsx src/auth-login.ts",
    "auth:link": "DATABASE_URL=postgresql://daily_updates_local:daily_updates_local@127.0.0.1:55433/daily_updates_local tsx src/auth-link.ts",
    "auth:server": "DATABASE_URL=postgresql://daily_updates_local:daily_updates_local@127.0.0.1:55433/daily_updates_local LOCAL_AUTH=oidc tsx src/local-server.ts",
    "auth:walkthrough": "WALKTHROUGH_AUTH=tokens tsx src/local-walkthrough.ts",
    "app:install": "npm --prefix app install",
    "app:web": "npm --prefix app run web"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@fastify/cors": "^11.3.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "zod": "^4.6.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
