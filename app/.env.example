# app/.env.example
#
# Copy to app/.env. These values are built into the app and sent to every
# browser, so they must never include a secret.

# Auth0 issuer, exactly as in the API's AUTH_ISSUER (with trailing slash).
EXPO_PUBLIC_AUTH_ISSUER=https://your-tenant.us.auth0.com/

# Client ID of the Auth0 Native Application for iOS and Android builds.
# A separate SPA client can be used for the web build.
EXPO_PUBLIC_AUTH_CLIENT_ID=your_native_app_client_id

# The API identifier set in Auth0, the same as the API's AUTH_AUDIENCE.
EXPO_PUBLIC_AUTH_AUDIENCE=https://daily-updates-api

# Where the Daily Updates API is running.
EXPO_PUBLIC_API_URL=https://your-api.example.com
